{
  "name": "the-known-world-navigator",
  "private": true,
  "version": "1.0.0",
  "description": "Citadel Route & Distance Engine for George R. R. Martin's A Song of Ice and Fire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/garcejan/got-map-explorer.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "test": "tsx scripts/audit_collisions.ts && tsx scripts/verify_all_nodes_routing.ts && tsx scripts/audit_all_routes.ts",
    "test:collisions": "tsx scripts/audit_collisions.ts",
    "test:routing": "tsx scripts/verify_all_nodes_routing.ts",
    "test:routes": "tsx scripts/audit_all_routes.ts",
    "test:water-coords": "tsx scripts/test_water_mask_and_coords.ts",
    "test:all": "npm test && tsx scripts/test_water_mask_and_coords.ts",
    "preview": "vite preview",
    "pr": "tsx scripts/create_pr.ts",
    "pr:create": "tsx scripts/create_pr.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
